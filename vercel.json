{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "server.ts",
        "package.json"
      ]
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
